managed implementation in class zbp_14_i_flightwithgeo unique;
strict ( 2 );
with draft;

define behavior for Z14_I_FlightWithGeo alias FlightWithGeo

persistent table z14_flights
lock master total etag LastChangedAt
authorization master ( instance )
draft table z14_flights_d
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;

  draft determine action Prepare;

  field ( readonly ) AirportFromId,
                     AirportToId,
                     DepartureLatitude,
                     DepartureLongitude,
                     ArrivalLatitude,
                     ArrivalLongitude;

  mapping for z14_flights
    {
      CarrierId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      Price              = price;
      CurrencyCode       = currency_code;
      PlaneTypeId        = plane_type_id;
      SeatsMax           = seats_max;
      SeatsOccupied      = seats_occupied;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}