managed implementation in class zbp_14_i_flightwithgeo unique;
strict ( 2 );
with draft;

define behavior for Z14_I_FlightWithGeo alias FlightWithGeo

persistent table z14_flights
lock master total etag LastChangedAt
authorization master ( instance )
draft table z14_flights_d
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;

  draft determine action Prepare;

  determination setFlightMasterData on modify { field CarrierId, ConnectionId; }

  determination setWeatherData on modify
  { field DepartureLatitude, DepartureLongitude,
    ArrivalLatitude, ArrivalLongitude, FlightDate; }

side effects {
    field FlightDate affects
        field DepartureWeatherStatus,
        field DepartureTemperature,
        field ArrivalWeatherStatus,
        field ArrivalTemperature,
        permissions ( field FlightDate ); }

  field ( readonly, numbering : managed ) UUID;

  field ( mandatory: create, readonly: update ) CarrierId, ConnectionId;

  field ( mandatory: create, features: instance ) FlightDate;

  field ( features: instance ) CurrencyCode;

  field ( readonly )
  AirportFromId,
  AirportToId,
  DepartureLatitude,
  DepartureLongitude,
  ArrivalLatitude,
  ArrivalLongitude,
  DepartureWeatherStatus,
  DepartureTemperature,
  ArrivalWeatherStatus,
  ArrivalTemperature,
  TravelAdvisory;

  mapping for z14_flights
    {
      UUID               = uuid;
      CarrierId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      Price              = price;
      CurrencyCode       = currency_code;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}